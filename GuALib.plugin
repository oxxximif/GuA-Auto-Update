# code
class GuALib(BasePlugin):

    def __init__(self):
        super().__init__()
        self.hook_ref = None

    def on_plugin_load(self):
        self.log("GuA Deeplink")
        self._setup_deeplink_handling()

    # localization
    def _download_local(self):
        pass

    # Clear cache
    def _clear_cache(self):
        pass

    # Other settings
    def _other_fragment(self):
        return [
            Header(text="Documentation"),
            Divider(text="The documentation is available at the link: https://telegra.ph/GuA-Plugin-11-03"),
            Header(text="Bugs"),
            Divider(text="If you find a bug in the plugin, write to the @GuAgchat chat in the Bugs topic using the pinned form.\n\nIf the bug is critical, write to @oxxximif in private messages"),
            Header(text="Thanks"),
            Divider(text="Thank you @QuantaPlugins for allowing us to use the QuantaHut features"),
            Header(text="Developers"),
            Divider(text="Main developers: @oxxximif")
        ]

    # Channel Links
    def _create_ChannelLin_fragment(self):
        try:
            from client_utils import get_last_fragment
            from java import jclass
            fragment = get_last_fragment()
            if fragment:
                MessagesController = jclass("org.telegram.messenger.MessagesController")
                messages_controller = MessagesController.getInstance(0)
                messages_controller.openByUserName("GuAmain", fragment, 1)
        except Exception as e:
            self.log(f"Error opening group: {e}")

    # GuA Chat
    def _create_ChatsLin_fragment(self):
        try:
            from client_utils import get_last_fragment
            from java import jclass
            fragment = get_last_fragment()
            if fragment:
                MessagesController = jclass("org.telegram.messenger.MessagesController")
                messages_controller = MessagesController.getInstance(0)
                messages_controller.openByUserName("GuAgchat", fragment, 1)
        except Exception as e:
            self.log(f"Error opening group: {e}")
        
    # QuantaPlugins
    def _create_cost_fragment(self):
        try:
            from client_utils import get_last_fragment
            from java import jclass
            fragment = get_last_fragment()
            if fragment:
                MessagesController = jclass("org.telegram.messenger.MessagesController")
                messages_controller = MessagesController.getInstance(0)
                messages_controller.openByUserName("QuantaPlugins", fragment, 1)
        except Exception as e:
            self.log(f"Error opening group: {e}")  
 
    # settings
    def create_settings(self):
        return [
            Header(text="GuALib settings"),
            Text(text="Download localization",icon="msg_translate",on_click=lambda v: self._download_local()),
            Text(text="Clear cache",icon="msg_clear",on_click=self._clear_cache),
            Text(text="Other",icon="menu_devices",create_sub_fragment=self._other_fragment),
            Divider(),
            Header(text="Links"),
            Text(text="Channel",icon="msg_channel_solar",on_click=lambda v: self._create_ChannelLin_fragment()),
            Text(text="Chats",icon="msg2_discussion",on_click=lambda v: self._create_ChatsLin_fragment()),
            Text(text="Thanks to QuantaPlugins",icon="msg_input_like",on_click=lambda v: self._create_cost_fragment()),
            Divider(text="Library for GuA | @GuAmain"),
        ] # qurovnya
    
    # DeepLink
    def _setup_deeplink_handling(self):
        try:
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            if not LaunchActivity:
                return

            method = LaunchActivity.getClass().getDeclaredMethod("handleIntent",
                find_class("android.content.Intent"),
                find_class("java.lang.Boolean").TYPE,
                find_class("java.lang.Boolean").TYPE,
                find_class("java.lang.Boolean").TYPE,
                find_class("org.telegram.messenger.browser.Browser$Progress"),
                find_class("java.lang.Boolean").TYPE,
                find_class("java.lang.Boolean").TYPE
            )
            method.setAccessible(True)
            self.hook_ref = self.hook_method(method, GuADeeplinkHook(self))
            self.log("Deeplink хук установлен успешно")
        except Exception as e:
            self.log(f"Ошибка установки deeplink хука: {e}")

    def _handle_gua_deeplink(self, uri: str):
        try:
            parsed = urlparse(uri)
            path = parsed.path.lower().lstrip("/") if parsed.path else ""
            params = parse_qs(parsed.query)

            if path == "update" or "update" in params:
                BulletinHelper.show_success("♡ GuA update check triggered via tg://gua/update")

            elif path == "donate" or path == "support":
                BulletinHelper.show_success("♡ Спасибо за поддержку GuA! Донат-шит открыт через tg://gua/donate")

            elif path == "settings":
                from com.exteragram.messenger.plugins import PluginsController
                PluginsController.getInstance().openPluginSettings("gualib")
                BulletinHelper.show_info("Открыты настройки по tg://gua/settings")

            elif "start" in params:
                start_param = params["start"][0]
                BulletinHelper.show_success(f"♡ GuA deeplink с параметром: {start_param}")

            else:
                BulletinHelper.show_success("♡ tg://gua deeplink успешно обработан! @GuAplm")

        except Exception as e:
            self.log(f"Ошибка обработки deeplink: {e}")


class GuADeeplinkHook:
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            intent = param.args[0]
            if not intent:
                return

            uri = intent.getDataString()
            if not uri:
                return

            uri_lower = uri.lower()

            if uri_lower.startswith("tg://gua"):
                param.setResult(True)

                run_on_ui_thread(lambda: self.plugin._handle_gua_deeplink(uri))

        except Exception as e:
            self.plugin.log(f"GuA deeplink hook error: {e}")


    def on_plugin_unload(self):
        if self.hook_ref:
            try:
                self.unhook_method(self.hook_ref)
            except:
                pass
        self.log("GuA Deeplink плагин выгружен")